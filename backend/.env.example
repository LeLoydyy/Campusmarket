PORT=5001
# Requests per IP per 15 minutes (default 300). Campus networks share IPs — raise if students hit limits.
# RATE_LIMIT_MAX=300
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Production (Supabase): Project Settings → Database → Connection string → URI.
# Use the "Session pooler" string if your host has no IPv6.
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
#
# Leave DATABASE_URL unset for local development: an embedded Postgres (PGlite)
# is stored in PGLITE_DIR (default backend/.data/pglite).
# PGLITE_DIR=.data/pglite

# ── Product photos ────────────────────────────────────────────────────────────
# Default: local disk (backend/uploads/products) — fine for development only;
# most hosts wipe the disk on redeploy. For production use Supabase Storage:
# PHOTO_STORAGE=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...   (Project Settings → API Keys → Secret keys)
# SUPABASE_PHOTO_BUCKET=product-images
# Move photos uploaded before switching: npm run photos:migrate

# Creates this administrator on startup if it doesn't exist (use for a fresh database).
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# Demo accounts are seeded into an empty database outside production.
# SEED_DEMO=false disables it; SEED_PASSWORD sets their password (random otherwise).
SEED_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:5002
AI_SERVICE_SECRET=replace-with-a-long-random-string

# ── Email (sign-up and sign-in codes) ─────────────────────────────────────────
# console: codes are printed in this log and, outside production, shown on screen.
# smtp: real delivery, e.g. a Google Workspace account on csucc.edu.ph
#   (SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = an app password).
EMAIL_PROVIDER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Campus Market <no-reply@csucc.edu.ph>"
# Only addresses on this domain can create accounts (default csucc.edu.ph).
# ALLOWED_EMAIL_DOMAIN=csucc.edu.ph

# ── Premium plan (shown on the seller's Plans page) ───────────────────────────
# Leave empty to show "Ask the admin office". Payment happens outside the app; sellers
# can add a GCash / receipt reference to their request and an admin approves it.
# PREMIUM_PRICE=₱150 per semester
# PREMIUM_PAYMENT_INFO=Pay at the OSAS office (Room 104) or GCash 0917 000 0000 (Campus Market). Put the reference number in your request.
