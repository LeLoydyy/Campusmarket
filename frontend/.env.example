# Only variables prefixed with VITE_ reach the browser — never put secrets here.
VITE_API_URL=/api
# Dev server only: true hides the sign-up email code (pair with SKIP_EMAIL_OTP=true in the backend).
# VITE_SKIP_EMAIL_OTP=false
# Optional: where event stall maps open before anything is pinned ("lat,lng"). Defaults to CSU Cabadbaran.
# VITE_CAMPUS_CENTER=9.1237,125.5349
